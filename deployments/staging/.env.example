APP_ENV=staging
API_KEY=replace-with-secret
PLAYBACK_TOKEN_SECRET=replace-with-32-byte-secret
AUTH_TOKEN_SECRET=replace-with-different-32-byte-secret
CORS_ALLOWED_ORIGIN=https://player.staging.example.com
ALLOW_PRIVATE_HLS=false
POSTGRES_PASSWORD=replace-with-secret
MINIO_ENDPOINT=minio.staging.example.com
MINIO_ROOT_USER=replace-with-access-key
MINIO_ROOT_PASSWORD=replace-with-secret
MINIO_BUCKET=vod2live
MINIO_USE_SSL=true
MEDIA_KEEP_ORIGINAL=false
